{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/regel4-dispatch.mjs\"", "timeout": 20 },
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/ktlint-check.mjs\"", "timeout": 30 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/regel4-dispatch.mjs\" --stop", "timeout": 60 }
        ]
      }
    ]
  }
}
